# ===================================================================
# ローカル開発用環境変数（従来のNext.js SSR版）
# AWS構成では使用しません（SSM Parameterで管理）
# ===================================================================

# Prometheus Configuration (ローカル開発のみ)
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_USERNAME=admin
PROMETHEUS_PASSWORD=password
PROMETHEUS_CACHE_MAX_AGE=60

# Discord Configuration (ローカル開発のみ)
DISCORD_WEBHOOK_SECRET=your-webhook-secret-here

# ===================================================================
# AWS構成では以下をSSM Parameterとして設定:
# - /status-page/prometheus/url
# - /status-page/prometheus/username
# - /status-page/prometheus/password
# - /status-page/discord/public-key
# ===================================================================
