{
  "categories": [
    {
      "id": "handon-club",
      "name": {
        "ja": "はんドンクラブ",
        "en": "Handon Club"
      },
      "description": {
        "ja": "誰でも参加できる汎用の Mastodon サーバーです。",
        "en": "A general-purpose Mastodon server open to everyone."
      },
      "url": "https://handon.club/",
      "version": {
        "manifest": "manifests/handon/prd/web.yaml",
        "image": "ghcr.io/highemerly/mastodon",
        "displayPattern": "^(\\d+\\.\\d+\\.\\d+)",
        "releases": {
          "repo": "mastodon/mastodon",
          "tagPrefix": "v"
        }
      }
    },
    {
      "id": "hiyoko-club",
      "name": {
        "ja": "ひよこスキー",
        "en": "Hiyoko Ski"
      },
      "description": {
        "ja": "子育てに関する話題を中心とした Misskey サーバーです。",
        "en": "A Misskey server centred on parenting and childcare."
      },
      "url": "https://mi.hiyoko.club/",
      "version": {
        "manifest": "manifests/hiyoko/prd/web.yaml",
        "image": "misskey/misskey",
        "releases": {
          "repo": "misskey-dev/misskey"
        }
      }
    },
    {
      "id": "hosteka",
      "name": "Hosteka",
      "description": {
        "ja": "Fediverse のアカウントでログインし、オフ会の参加者を募集できるサービスです。",
        "en": "Organise meetups and gather attendees by signing in with a Fediverse account."
      },
      "url": "https://hosteka.piyo.me/",
      "version": {
        "manifest": "manifests/hosteka/prd/web.yaml",
        "image": "ghcr.io/highemerly/hosteka"
      }
    },
    {
      "id": "shamezo",
      "name": "SHAMEZO",
      "description": {
        "ja": "画像にテキストを合成して共有できる写真 SNS です。",
        "en": "A photo-sharing service for compositing text onto images."
      },
      "url": "https://pic.handon.club/",
      "version": {
        "manifest": "manifests/movapic-neo/prd/web.yaml",
        "image": "ghcr.io/highemerly/movapic-neo",
        "releases": {
          "repo": "highemerly/movapic-neo",
          "tagPrefix": "v",
          "fallbackTags": [
            "{major}.{minor}.0"
          ]
        }
      }
    },
    {
      "id": "anypost",
      "name": "anypost",
      "description": {
        "ja": "ひとつのリンクから、Fediverse や既存 SNS など好きな投稿先に投稿できるサービスです。",
        "en": "Post to the Fediverse and other social networks from a single link."
      },
      "url": "https://anypost.dev/",
      "version": {
        "manifest": "manifests/anypost/prd/web.yaml",
        "image": "ghcr.io/highemerly/anypost-web"
      }
    },
    {
      "id": "dominion",
      "name": {
        "ja": "ふつうのドミニオンセレクタ",
        "en": "Dominion Selector"
      },
      "description": {
        "ja": "ボードゲーム「ドミニオン」で使うサプライを、ランダムに選出するサービスです。",
        "en": "Randomly picks the kingdom card supply for the board game Dominion."
      },
      "url": "https://dominion.highemerly.net/",
      "version": {
        "manifest": "manifests/dominion/prd/web.yaml",
        "image": "ghcr.io/highemerly/dominion"
      }
    },
    {
      "id": "common",
      "name": {
        "ja": "共通",
        "en": "Common"
      },
      "description": {
        "ja": "各サービスが共通して使う基盤の稼働状況です。",
        "en": "Shared infrastructure that all of the services above depend on."
      }
    }
  ],
  "services": [
    {
      "id": "handon-web",
      "name": "Web",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='handon'}",
      "categoryId": "handon-club"
    },
    {
      "id": "handon-streaming",
      "name": "Streaming",
      "prometheusQuery": "probe_http_status_code{endpoint='streaming', env='production', service='handon'}",
      "categoryId": "handon-club"
    },
    {
      "id": "handon-media",
      "name": "Media",
      "prometheusQuery": "probe_http_status_code{endpoint='media', env='production', service='handon'}",
      "categoryId": "handon-club"
    },
    {
      "id": "handon-search",
      "name": "Search",
      "prometheusQuery": "probe_http_status_code{endpoint='search', env='production', service='handon'}",
      "categoryId": "handon-club"
    },
    {
      "id": "handon-db",
      "name": "Database",
      "prometheusQuery": "cnpg_collector_up{namespace='handon-prd'}",
      "categoryId": "handon-club"
    },
    {
      "id": "handon-sidekiq",
      "name": "Queue",
      "prometheusQuery": [
        "max(sidekiq_queue_latency_seconds{service='handon', env='production'}) < bool 180",
        "max(sidekiq_queue_latency_seconds{service='handon', env='production'}) < bool 900"
      ],
      "categoryId": "handon-club"
    },
    {
      "id": "hiyoko-web",
      "name": "Web",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='hiyoko'}",
      "categoryId": "hiyoko-club"
    },
    {
      "id": "hiyoko-media",
      "name": "Media",
      "prometheusQuery": "probe_http_status_code{endpoint='media', env='production', service='hiyoko'}",
      "categoryId": "hiyoko-club"
    },
    {
      "id": "hiyoko-delivery",
      "name": "Media Proxy",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='next-media-delivery'}",
      "categoryId": "hiyoko-club"
    },
    {
      "id": "hiyoko-db",
      "name": "Database",
      "prometheusQuery": "cnpg_collector_up{namespace='hiyoko-prd'}",
      "categoryId": "hiyoko-club"
    },
    {
      "id": "hosteka-web",
      "name": "Web",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='hosteka'}",
      "categoryId": "hosteka"
    },
    {
      "id": "hosteka-delivery",
      "name": "Media Proxy",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='next-media-delivery'}",
      "categoryId": "hosteka"
    },
    {
      "id": "hosteka-db",
      "name": "Database",
      "prometheusQuery": "cnpg_collector_up{namespace='shared-postgres-prd'}",
      "categoryId": "hosteka"
    },
    {
      "id": "anypost-web",
      "name": "Front",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='anypost'}",
      "categoryId": "anypost"
    },
    {
      "id": "anypost-api",
      "name": "Fediverse API",
      "prometheusQuery": "probe_http_status_code{endpoint='api', env='production', service='anypost'}",
      "categoryId": "anypost"
    },
    {
      "id": "dominion-static",
      "name": "Front",
      "prometheusQuery": "probe_http_status_code{endpoint='static', env='production', service='dominion'}",
      "categoryId": "dominion"
    },
    {
      "id": "dominion-api",
      "name": "Dominion API",
      "prometheusQuery": "probe_http_status_code{endpoint='api', env='production', service='dominion'}",
      "categoryId": "dominion"
    },
    {
      "id": "movapic-neo-web",
      "name": "Web",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='movapic-neo'}",
      "categoryId": "shamezo"
    },
    {
      "id": "movapic-neo-delivery",
      "name": "Media Proxy",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='next-media-delivery'}",
      "categoryId": "shamezo"
    },
    {
      "id": "movapic-neo-db",
      "name": "Database",
      "prometheusQuery": "cnpg_collector_up{namespace='shared-postgres-prd'}",
      "categoryId": "shamezo"
    },
    {
      "id": "common-k8s",
      "name": {
        "ja": "Server (Kubernetes)",
        "en": "Server (Kubernetes)"
      },
      "prometheusQuery": [
        "kube_node_status_condition{condition='Ready', status='true'}",
        "(sum(kube_node_status_condition{condition='Ready', status='true'}) or vector(0)) >= bool 1"
      ],
      "categoryId": "common"
    },
    {
      "id": "common-monitoring",
      "name": {
        "ja": "Metrics (Victoria Metrics)",
        "en": "Metrics (Victoria Metrics)"
      },
      "prometheusQuery": [
        "(count(up{job='blackbox-http'} == 1) or vector(0)) > bool 0",
        "(count(up{namespace='monitoring'} == 1) or vector(0)) > bool 0"
      ],
      "categoryId": "common"
    },
    {
      "id": "common-rum",
      "name": {
        "ja": "Real-User Monitoring (N-RUM)",
        "en": "Real-User Monitoring (N-RUM)"
      },
      "prometheusQuery": "probe_http_status_code{env='production', service='next-rum'}",
      "categoryId": "common"
    },
    {
      "id": "common-delivery",
      "name": "Media Proxy (NMD)",
      "prometheusQuery": "probe_http_status_code{endpoint='web', env='production', service='next-media-delivery'}",
      "categoryId": "common"
    }
  ]
}
